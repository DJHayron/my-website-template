NEXT_PUBLIC_SITE_NAME=PortfolioKit
NEXT_PUBLIC_SITE_URL=https://portfolio.example.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Local development path. The production image overrides this with
# /app/content/blog so a named or bind mount can persist the whole content tree.
BLOG_CONTENT_DIRECTORY=./content/blog

# Admin session settings.
ADMIN_JWT_ISSUER=hayronhgh-admin-cms
ADMIN_JWT_AUDIENCE=hayronhgh-admin-console
ADMIN_TOKEN_TTL_SECONDS=3600
ADMIN_ALLOWED_ORIGINS=https://cms.example.com
ADMIN_CMS_WRITE_ENABLED=true
ADMIN_TRUST_PROXY_HEADERS=false

# Production: run `pnpm admin:generate-secret`, store the output in a secret
# manager, and inject it at runtime. Never commit the generated value.
ADMIN_JWT_SECRET=GENERATE_WITH_PNPM_ADMIN_GENERATE_SECRET

# Generate each passwordHash with
# `pnpm admin:hash-password` using its hidden prompt. This is intentionally an
# invalid placeholder, not a usable password hash.
ADMIN_USERS_JSON=[{"username":"admin","displayName":"Site administrator","role":"admin","passwordHash":"GENERATE_WITH_PNPM_ADMIN_HASH_PASSWORD"}]
